# .env.local — Firebase 설정값을 여기에 입력하세요
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_SHEET_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Management system API and server-side storage
VITE_MANAGEMENT_API_ENABLED=true
MANAGEMENT_API_BASE_URL=https://ieumwindow.kr/api/v1/dashboard
MANAGEMENT_API_KEY=paste-management-api-key-here
APPS_SCRIPT_AUTH_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
POSTGRES_URL=postgresql://user:password@host/database
CRON_SECRET=replace-with-a-long-random-value
